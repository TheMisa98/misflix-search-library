#!/usr/bin/env bash
# Corre antes de cada `git push` (ver `core.hooksPath` en CLAUDE.md/README):
# lint, formato, tipos y tests. Si algo falla, el push se cancela.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] ruff check..."
uv run ruff check .

echo "[pre-push] ruff format --check..."
uv run ruff format --check .

echo "[pre-push] mypy..."
uv run mypy

echo "[pre-push] pytest..."
uv run pytest -q

echo "[pre-push] OK"
